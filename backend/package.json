{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend de Norma ERP con PERN",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "db:seed": "node prisma/seed.js",
    "prisma:dev": "dotenv -e ../.env -- npx prisma migrate dev",
    "prisma:studio": "dotenv -e ../.env -- npx prisma studio",
    "postinstall": "npx prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:stress": "node tests/stress/aiFrameworkStress.js"
  },
  "keywords": [],
  "author": "Jorge Doicela",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/server": "^13.2.3",
    "axios": "^1.13.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
