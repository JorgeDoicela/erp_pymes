PORT=4000
DATABASE_URL="postgresql://usuario:password@localhost:5432/db_recursos_humanos?schema=public"

# =================== SEGURIDAD ===================
# Clave de encriptación para salarios
# Generar una nueva clave segura ejecutando:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-32-byte-hex-key-here"

# Secreto para autorizar la ejecución del seed por endpoint de forma segura
SEED_SECRET="your-seed-secret-here"

# =================== CONFIGURACIÓN DE RED / CORS ===================
# URL del frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# URL de origen (usado para WebAuthn y CORS)
ORIGIN="http://localhost:5173"

# ID de Relying Party para autenticación biométrica
# (En local es "localhost", en producción es tu dominio de Vercel sin https://)
RP_ID="localhost"

# =================== CONFIGURACIÓN DE CORREO ===================
# Correo electrónico para el envío de notificaciones
EMAIL_USER="your-email@gmail.com"
# Contraseña de aplicación de Gmail (16 caracteres) o del SMTP
EMAIL_PASS="your-smtp-app-password"
