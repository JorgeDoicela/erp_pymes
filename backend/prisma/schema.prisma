generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  ruc                String?  @unique
  plan               String   @default("ESSENTIAL") // ESSENTIAL, GROWTH, ENTERPRISE
  subscriptionStatus String   @default("ACTIVE")    // TRIAL, ACTIVE, SUSPENDED, CANCELLED
  maxEmployees       Int      @default(50)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employees          Employee[]
  systemSettings     SystemSetting[]
  payrollConfigs     PayrollConfig[]
  payrolls           Payroll[]
  accountingPeriods  AccountingPeriod[]
  accountingAccounts AccountingAccount[]
  costCenters        CostCenter[]
  journalEntries     JournalEntry[]
  jobVacancies       JobVacancy[]
  announcements      Announcement[]
  climateSurveys     ClimateSurvey[]
  evaluationTemplates EvaluationTemplate[]
  shifts             Shift[]
  auditLogs          AuditLog[]
  rsiCalibrations    RsiCalibration[]
  rsiPredictionAudits RsiPredictionAudit[]
  causalInterventions CausalIntervention[]
  privacyBudget       TenantPrivacyBudget?
  morlPolicyRuns      MorlPolicyRun[]

  @@map("tenants")
}

model Employee {
  id                   String                  @id @default(cuid())
  tenantId             String?
  tenant               Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName            String
  lastName             String
  email                String                  @unique
  department           String
  position             String
  salary               String
  password             String
  role                 String                  @default("employee")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  address              String
  birthDate            DateTime
  civilStatus          String
  contractType         String
  hireDate             DateTime
  identityCard         String
  phone                String
  vacationDays         Int                     @default(15)
  accountNumber        String?
  accountType          String?
  bankName             String?
  exitDate             DateTime?
  exitReason           String?
  exitType             String?
  isActive             Boolean                 @default(true)
  absences             AbsenceRequest[]
  attendance           Attendance[]
  candidateEvaluations CandidateEvaluation[]
  contracts            Contract[]
  documents            Document[]
  benefits             EmployeeBenefit[]
  evaluations          EmployeeEvaluation[]
  goals                EmployeeGoal[]
  schedules            EmployeeSchedule[]
  reviewedEvaluations  EvaluationReviewer[]
  biometricCredentials BiometricCredential[]
  interviews           Interview[]
  postedVacancies      JobVacancy[]
  preferences          NotificationPreference?
  notifications        Notification[]
  PayrollDetail        PayrollDetail[]
  skills               Skill[]
  workHistory          WorkHistory[]
  currentChallenge     String?
  workLatitude         String?
  workLongitude        String?
  geofenceRadius       Float?                  @default(200)
  enforceGeofence      Boolean                 @default(false)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  trackingConsent      Boolean                 @default(false)
  trackingConsentDate  DateTime?
  salaryAdvances       SalaryAdvance[]
  assets               EmployeeAsset[]
  offboardings         OffboardingProcess[]
  announcementReads    AnnouncementRead[]
  createdAnnouncements Announcement[]          @relation("CreatedAnnouncements")
  entrepreneurships    Entrepreneurship[]       @relation("ProjectOwner")
  projectMemberships   EntrepreneurshipMember[]
  projectMentorships   EntrepreneurshipMentor[]

  @@index([email])
  @@index([department])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, role])
  @@index([hireDate])
  @@index([exitDate])
  @@index([isActive])
  @@unique([tenantId, identityCard])
  @@map("employees")
}

model EmployeeGoal {
  id           String   @id @default(uuid())
  employeeId   String
  title        String
  description  String?
  metric       String   @default("Manual")
  targetValue  Float
  currentValue Float    @default(0)
  unit         String   @default("%")
  deadline     DateTime
  priority     String   @default("MEDIUM")
  status       String   @default("PENDING")
  progress     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_goals")
}

model AbsenceRequest {
  id           String   @id @default(cuid())
  type         String
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       String   @default("PENDING")
  evidenceUrl  String?
  adminComment String?
  employeeId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, status])
  @@index([status, startDate, endDate])
  @@index([createdAt])
  @@map("absence_requests")
}

model Attendance {
  id               String    @id @default(cuid())
  date             DateTime
  checkIn          DateTime
  checkOut         DateTime?
  workedHours      Float?
  status           String
  employeeId       String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  entryLatitude    String?
  entryLongitude   String?
  exitLatitude     String?
  exitLongitude    String?
  breakEnd         DateTime?
  breakStart       DateTime?
  isEarlyDeparture Boolean   @default(false)
  isLate           Boolean   @default(false)
  overtimeHours    Float?    @default(0)
  ipAddress        String?
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([employeeId, date, status])
  @@index([isLate])
  @@map("attendance")
}

model Shift {
  id               String             @id @default(cuid())
  tenantId         String?
  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  startTime        String
  endTime          String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  breakMinutes     Int                @default(60)
  toleranceMinutes Int                @default(15)
  schedules        EmployeeSchedule[]

  @@index([tenantId])
  @@map("shifts")
}

model EmployeeSchedule {
  id         String    @id @default(cuid())
  employeeId String
  shiftId    String
  startDate  DateTime
  endDate    DateTime?
  daysOfWeek String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift      Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([shiftId])
  @@index([employeeId, isActive, startDate])
  @@map("employee_schedules")
}

model Skill {
  id         String   @id @default(cuid())
  name       String
  level      String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("skills")
}

model WorkHistory {
  id          String    @id @default(cuid())
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("work_history")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity      String
  entityId    String
  action      String
  performedBy String
  details     String
  ip          String?
  timestamp   DateTime @default(now())

  @@index([tenantId])
  @@index([entityId])
  @@index([timestamp])
  @@index([entity])
  @@index([action])
  @@index([tenantId, timestamp])
  @@map("audit_logs")
}

model Contract {
  id                String    @id @default(cuid())
  type              String
  startDate         DateTime
  endDate           DateTime?
  salary            Float
  clauses           String?
  documentUrl       String?
  status            String    @default("Active")
  employeeId        String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  hasDoubleOvertime Boolean   @default(true)
  hasNightSurcharge Boolean   @default(true)
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
  @@index([startDate])
  @@index([endDate])
  @@map("contracts")
}

model Document {
  id                String    @id @default(cuid())
  type              String
  documentCategory  String    @default("OTHER") // IDENTIFICATION, BANK_CERTIFICATE, TITLE_DIPLOMA, POLICE_RECORD, CURRICULUM, SAFETY_CERTIFICATE, OTHER
  status            String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNotes String?
  verifiedBy        String?
  verifiedAt        DateTime?
  employeeId        String
  createdAt         DateTime  @default(now())
  documentUrl       String
  expiryDate        DateTime?
  mimeType          String?
  originalName      String?
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([expiryDate])
  @@map("documents")
}

model PayrollConfig {
  id          String        @id @default(cuid())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workingDays Int           @default(30)
  currency    String        @default("USD")
  validFrom   DateTime      @default(now())
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       PayrollItem[]

  @@index([tenantId])
  @@map("payroll_configs")
}

model PayrollItem {
  id          String        @id @default(cuid())
  name        String
  type        String
  isMandatory Boolean       @default(false)
  percentage  Float?
  fixedValue  Float?
  configId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  config      PayrollConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@map("payroll_items")
}

model Payroll {
  id          String          @id @default(cuid())
  tenantId    String?
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period      DateTime
  endDate     DateTime
  status      String          @default("DRAFT")
  totalAmount Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  paymentDate DateTime?
  details     PayrollDetail[]

  @@index([tenantId])
  @@index([period])
  @@index([paymentDate])
  @@index([createdAt])
  @@map("payrolls")
}

model PayrollDetail {
  id             String   @id @default(cuid())
  payrollId      String
  employeeId     String
  baseSalary     Float
  workedDays     Int
  overtimeHours  Float
  overtimeAmount Float
  bonuses        String
  deductions     String
  netSalary      Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payroll        Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@index([employeeId])
  @@map("payroll_details")
}

model EmployeeBenefit {
  id         String   @id @default(cuid())
  name       String
  amount     Float
  type       String
  frequency  String
  status     String   @default("ACTIVE")
  employeeId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, status])
  @@index([status])
  @@map("employee_benefits")
}

model EvaluationTemplate {
  id           String               @id @default(cuid())
  tenantId     String?
  tenant       Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  period       String
  instructions String?
  criteria     String
  scale        String
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  evaluations  EmployeeEvaluation[]

  @@index([tenantId])
  @@map("evaluation_templates")
}

model EmployeeEvaluation {
  id         String               @id @default(cuid())
  templateId String
  employeeId String
  startDate  DateTime
  endDate    DateTime
  status     String               @default("PENDING")
  finalScore Float?
  feedback   String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template   EvaluationTemplate   @relation(fields: [templateId], references: [id])
  reviewers  EvaluationReviewer[]

  @@index([templateId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
  @@index([endDate])
  @@index([createdAt])
  @@map("employee_evaluations")
}

model EvaluationReviewer {
  id           String             @id @default(cuid())
  evaluationId String
  reviewerId   String
  status       String             @default("PENDING")
  responses    String?
  comments     String?
  score        Float?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  evaluation   EmployeeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  reviewer     Employee           @relation(fields: [reviewerId], references: [id])

  @@index([evaluationId])
  @@index([reviewerId])
  @@index([status])
  @@map("evaluation_reviewers")
}

model JobVacancy {
  id                 String           @id @default(cuid())
  tenantId           String?
  tenant             Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  department         String
  description        String
  requirements       String
  benefits           String?
  salaryMin          Float?
  salaryMax          Float?
  currency           String           @default("USD")
  location           String
  employmentType     String
  deadline           DateTime
  status             String           @default("OPEN")
  postedById         String
  evaluationCriteria Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       JobApplication[]
  postedBy           Employee         @relation(fields: [postedById], references: [id])

  @@index([tenantId])
  @@index([postedById])
  @@index([status])
  @@index([department])
  @@map("job_vacancies")
}

model JobApplication {
  id          String                @id @default(cuid())
  vacancyId   String
  firstName   String
  lastName    String
  email       String
  phone       String
  resumeUrl   String
  coverLetter String?
  status      String                @default("PENDING")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  notes       ApplicationNote[]
  evaluations CandidateEvaluation[]
  interviews  Interview[]
  vacancy     JobVacancy            @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId])
  @@index([status])
  @@map("job_applications")
}

model ApplicationNote {
  id            String         @id @default(cuid())
  applicationId String
  content       String
  createdBy     String
  createdById   String
  createdAt     DateTime       @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_notes")
}

model Interview {
  id            String         @id @default(cuid())
  applicationId String
  date          DateTime
  type          String
  location      String?
  interviewerId String
  notes         String?
  status        String         @default("SCHEDULED")
  createdAt     DateTime       @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer   Employee       @relation(fields: [interviewerId], references: [id])

  @@index([applicationId])
  @@index([interviewerId])
  @@map("interviews")
}

model CandidateEvaluation {
  id             String         @id @default(cuid())
  applicationId  String
  evaluatorId    String
  ratings        Json
  comments       String
  recommendation String
  overallScore   Float
  createdAt      DateTime       @default(now())
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluator      Employee       @relation(fields: [evaluatorId], references: [id])

  @@index([applicationId])
  @@map("candidate_evaluations")
}

model ClimateSurvey {
  id          String            @id @default(cuid())
  tenantId    String?
  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean           @default(true)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  responses   ClimateResponse[]

  @@index([tenantId])
  @@map("climate_surveys")
}

model ClimateResponse {
  id         String        @id @default(cuid())
  surveyId   String
  department String?
  ratings    String
  comments   String?
  npsScore   Int?
  createdAt  DateTime      @default(now())
  survey     ClimateSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("climate_responses")
}

model Notification {
  id              String   @id @default(cuid())
  recipientId     String
  title           String
  message         String
  type            String
  isRead          Boolean  @default(false)
  relatedEntityId String?
  relatedEntity   String?
  createdAt       DateTime @default(now())
  recipient       Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  preferences Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model SystemSetting {
  id                   String    @id @default(cuid())
  tenantId             String?   @unique
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceMode      Boolean   @default(false)
  maintenanceScheduled DateTime?
  maintenanceMessage   String?
  biometricEnabled     Boolean   @default(false)
  allowedIPs           String?   // Permitted IP ranges (comma separated)
  globalLatitude       String?    // Global workplace coordinates
  globalLongitude      String?
  globalRadius         Float?    @default(200) // Default global radius in meters
  updatedAt            DateTime  @updatedAt

  @@map("system_settings")
}

model BiometricCredential {
  id           String   @id @default(cuid())
  employeeId   String
  credentialId String   @unique
  publicKey    String
  aaguid       String?  // Hardware authenticator ID
  counter      Int      @default(0)
  transports   String?  // JSON list of transports
  deviceInfo   String?
  lastVerified DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("biometric_credentials")
}

// ============================================================================
// MODULO DE CONTABILIDAD FINANCIERA (AISLADO)
// ============================================================================

model AccountingPeriod {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  startDate DateTime
  endDate   DateTime
  status    String   @default("OPEN") // OPEN, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, year, month])
  @@map("acc_periods")
}

model AccountingAccount {
  id           String              @id @default(cuid())
  tenantId     String?
  tenant       Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  name         String
  description  String?
  type         String              // ASSET (Activo), LIABILITY (Pasivo), EQUITY (Patrimonio), REVENUE (Ingreso), EXPENSE (Gasto)
  level        Int                 @default(1)
  isTransactional Boolean          @default(false) // Si false, es una cuenta agrupadora
  parentId     String?
  parent       AccountingAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  subAccounts  AccountingAccount[] @relation("AccountHierarchy")
  lines        JournalLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  isActive     Boolean             @default(true)

  @@index([tenantId])
  @@index([code])
  @@index([parentId])
  @@unique([tenantId, code])
  @@map("acc_accounts")
}

model CostCenter {
  id          String        @id @default(cuid())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  isActive    Boolean       @default(true)
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@unique([tenantId, code])
  @@map("acc_cost_centers")
}

model JournalEntry {
  id              String        @id @default(cuid())
  tenantId        String?
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNumber     String        // Ej: ACC-2026-0001
  date            DateTime
  description     String
  type            String        // DAILY (Diario), INCOME (Ingreso), EXPENSE (Egreso)
  status          String        @default("DRAFT") // DRAFT, POSTED, ANNULLED
  totalDebit      Float         @default(0)
  totalCredit     Float         @default(0)
  
  // Nexo Opcional con RRHH (No restrictivo)
  referenceModule String?       // Ej: PAYROLL, LOAN
  referenceId     String?       // Ej: ID de la Nómina
  
  lines           JournalLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([date])
  @@index([entryNumber])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([referenceModule, referenceId])
  @@unique([tenantId, entryNumber])
  @@map("acc_journal_entries")
}

model JournalLine {
  id             String            @id @default(cuid())
  journalEntryId String
  accountId      String
  costCenterId   String?
  description    String?
  debit          Float             @default(0)
  credit         Float             @default(0)

  journalEntry   JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter     CostCenter?       @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([journalEntryId])
  @@index([accountId])
  @@index([journalEntryId, accountId])
  @@index([costCenterId])
  @@map("acc_journal_lines")
}

// ============================================================================
// MODULO DE EMPRENDIMIENTO (INCUBADORA PROFESIONAL - AISLADO)
// ============================================================================

model Entrepreneurship {
  id              String                   @id @default(cuid())
  title           String
  description     String
  industry        String?
  stage           String                   @default("IDEATION") // IDEATION, VALIDATION, MVP, SCALING
  status          String                   @default("ACTIVE")   // ACTIVE, COMPLETED, SUSPENDED
  valuation       Float?                   @default(0)
  currency        String                   @default("USD")
  equityAvailable Float?                   @default(100)
  budget          Float?                   @default(0)
  expenses        Float?                   @default(0)
  innovationScore Float?                   @default(0)
  logoUrl         String?
  videoPitchUrl   String?
  pitchNarrative  String?                  // Para el análisis de IA
  
  // Growth Metrics (Métricas de Crecimiento)
  growthMRR       Float?                   @default(0)
  growthUsers     Int?                     @default(0)
  growthCAC       Float?                   @default(0)
  growthLTV       Float?                   @default(0)
  
  // Relación con el creador (Dueño principal)
  ownerId         String
  owner           Employee                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Relaciones del módulo
  members         EntrepreneurshipMember[]
  mentors         EntrepreneurshipMentor[]
  milestones      EntrepreneurshipMilestone[]
  documents       EntrepreneurshipDocument[]
  updates         EntrepreneurshipUpdate[]
  equities        EntrepreneurshipEquity[]
  fundingRounds   EntrepreneurshipFundingRound[]
  interviews      EntrepreneurshipInterview[]
  targetMarket    EntrepreneurshipTargetMarket?
  
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("ent_projects")
}

model EntrepreneurshipEquity {
  id               String           @id @default(cuid())
  projectId        String
  holderName       String           
  percentage       Float
  role             String           // Founder, Investor, Advisor, Employee
  vestingTerms     String?          
  
  project          Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt        DateTime         @default(now())

  @@index([projectId])
  @@map("ent_equities")
}

model EntrepreneurshipFundingRound {
  id               String           @id @default(cuid())
  projectId        String
  roundName        String           // Pre-Seed, Seed, Series A
  amountRaised     Float
  valuation        Float
  date             DateTime
  investors        String?
  
  project          Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt        DateTime         @default(now())

  @@index([projectId])
  @@map("ent_funding_rounds")
}

model EntrepreneurshipInterview {
  id               String           @id @default(cuid())
  projectId        String
  customerName     String
  feedback         String
  sentiment        String?          // POSITIVE, NEUTRAL, NEGATIVE
  insights         String?
  
  project          Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt        DateTime         @default(now())

  @@index([projectId])
  @@map("ent_interviews")
}

model EntrepreneurshipTargetMarket {
  id               String           @id @default(cuid())
  projectId        String           @unique
  tam              Float?           // Total Addressable Market
  sam              Float?           // Serviceable Addressable Market
  som              Float?           // Serviceable Obtainable Market
  
  project          Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)

  updatedAt        DateTime         @updatedAt

  @@map("ent_target_market")
}

model EntrepreneurshipMember {
  id              String           @id @default(cuid())
  projectId       String
  employeeId      String?          // Opcional si es externo
  externalName    String?
  externalEmail   String?
  role            String           // CEO, CTO, Developer, etc.
  
  project         Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([employeeId])
  @@map("ent_members")
}

model EntrepreneurshipMentor {
  id              String           @id @default(cuid())
  projectId       String
  employeeId      String?          // Un experto interno de la empresa
  mentorName      String
  specialty       String
  email           String?
  
  project         Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("ent_mentors")
}

model EntrepreneurshipMilestone {
  id              String           @id @default(cuid())
  projectId       String
  title           String
  description     String?
  dueDate         DateTime
  completedDate   DateTime?
  status          String           @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  kanbanColumn    String           @default("BACKLOG") // BACKLOG, IN_PROGRESS, REVIEW, DONE
  
  project         Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ent_milestones")
}

model EntrepreneurshipDocument {
  id              String           @id @default(cuid())
  projectId       String
  title           String           // Pitch Deck, Financial Plan, etc.
  fileUrl         String
  fileType        String?
  version         String           @default("1.0")
  
  project         Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ent_documents")
}

model EntrepreneurshipUpdate {
  id              String           @id @default(cuid())
  projectId       String
  title           String
  content         String
  type            String           @default("GENERAL") // PROGRESS, PIVOT, FINANCIAL, NEWS
  
  project         Entrepreneurship @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime         @default(now())

  @@index([projectId])
  @@map("ent_updates")
}

model SalaryAdvance {
  id               String    @id @default(cuid())
  employeeId       String
  amount           Float
  installments     Int       @default(1)
  monthlyDeduction Float
  reason           String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID, CANCELLED
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  paidAmount       Float     @default(0)
  paidInstallments Int       @default(0)
  requestDate      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("salary_advances")
}

model EmployeeAsset {
  id                 String    @id @default(cuid())
  employeeId         String
  name               String    // Ej: Laptop Lenovo ThinkPad T14, Uniforme Talla M, Casco de Seguridad
  serialNumber       String?
  category           String    @default("EQUIPMENT") // EQUIPMENT, UNIFORM_PPE, TOOL, ACCESS_CARD
  deliveryDate       DateTime  @default(now())
  condition          String    @default("GOOD") // NEW, GOOD, FAIR
  status             String    @default("DELIVERED") // DELIVERED, RETURNED, LOST_DAMAGED
  returnDate         DateTime?
  returnNotes        String?
  receiptSignatureUrl String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("employee_assets")
}

model OffboardingProcess {
  id                    String    @id @default(cuid())
  employeeId            String
  exitDate              DateTime
  causal                String    // VOLUNTARY_RESIGNATION, UNFAIR_DISMISSAL, CONTRACT_END, JUST_CAUSE
  status                String    @default("IN_PROGRESS") // IN_PROGRESS, PENDING_APPROVAL, COMPLETED
  checklist             String    // JSON: array de tareas de salida y entrega
  baseSalary            Float
  monthsWorked          Float
  thirteenthProportional Float    @default(0)
  fourteenthProportional Float    @default(0)
  vacationDaysOwed      Float     @default(0)
  vacationAmount        Float     @default(0)
  desahucioAmount       Float     @default(0)
  severanceAmount       Float     @default(0)
  totalSettlement       Float     @default(0)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("offboarding_processes")
}

model Announcement {
  id                     String             @id @default(cuid())
  tenantId               String?
  tenant                 Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title                  String
  content                String             @db.Text
  category               String             @default("GENERAL") // GENERAL, POLICY, HOLIDAY, BIRTHDAY
  priority               String             @default("NORMAL") // NORMAL, URGENT
  requiresAcknowledgment Boolean            @default(false)
  attachmentUrl          String?
  createdById            String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  createdBy              Employee           @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: Cascade)
  reads                  AnnouncementRead[]

  @@index([tenantId])
  @@index([createdById])
  @@index([category])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  employeeId     String
  readAt         DateTime     @default(now())
  acknowledged   Boolean      @default(false)

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@index([employeeId])
  @@map("announcement_reads")
}

model RsiCalibration {
  id                    String   @id @default(cuid())
  tenantId              String?
  tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  epoch                 Int      @default(1)
  brierScore            Float    // Pérdida cuadrática media (MSE)
  logLoss               Float    // Log Loss
  improvementPercentage Float    @default(0)
  weightsJson           String   @db.Text // Hiperparámetros calibrados (beta_salary, beta_absence, beta_perf, beta_no_promo, k_weibull, lambda_weibull, etc.)
  sampleCount           Int      @default(0)
  triggerReason         String   @default("MANUAL") // MANUAL, OFFBOARDING_EVENT, AUTOMATIC_SCHEDULE
  createdAt             DateTime @default(now())

  @@index([tenantId])
  @@index([epoch])
  @@map("rsi_calibrations")
}

model RsiPredictionAudit {
  id                String    @id @default(cuid())
  tenantId          String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String
  predictedScore    Float     // Score predicho (0-100)
  predictedTurnover Float     // Probabilidad de rotación predicha (0.0 - 1.0)
  actualOutcome     Int?      // 0 = Permaneció, 1 = Renunció/Desvinculado (null si aún no resuelto)
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@index([actualOutcome])
  @@map("rsi_prediction_audits")
}

model CausalIntervention {
  id                      String   @id @default(cuid())
  tenantId                String?
  tenant                  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title                   String
  treatmentType           String   // SALARY_INCREASE, REMOTE_WORK, CAREER_PROMOTION, TRAINING_PROGRAM
  treatmentValue          Float    // e.g. 10.0 for 10% salary increase or 2.0 for 2 days remote
  targetDepartment        String   @default("ALL")
  sampleSize              Int      @default(0)
  ate                     Float    // Average Treatment Effect (ej. -0.12 para 12% menos de rotación)
  baselineTurnoverRate    Float    // Probabilidad de fuga promedio antes de intervención
  counterfactualTurnoverRate Float // Probabilidad de fuga predicha tras intervención
  costEstimate            Float    // Costo estimado de la intervención ($)
  savingsEstimate         Float    // Ahorro estimado por retención de talento ($)
  netRoi                  Float    // Ahorro Neto ($) = savingsEstimate - costEstimate
  confidenceIntervalLower Float    // IC 95% Inferior
  confidenceIntervalUpper Float    // IC 95% Superior
  createdAt               DateTime @default(now())

  @@index([tenantId])
  @@index([treatmentType])
  @@map("causal_interventions")
}

model FederatedRound {
  id                        String   @id @default(cuid())
  round                     Int      @unique
  participatingTenantsCount Int      @default(0)
  globalWeightsJson         String   @db.Text // Pesos agregados por FedAvg (theta_global)
  globalBrierScore          Float    // Brier score global del meta-modelo
  epsilonUsed               Float    @default(0.5) // Épsilon utilizado en esta ronda por participante
  noiseScale                Float    @default(0.5) // Escala de ruido Gaussiano inyectado (sigma)
  status                    String   @default("COMPLETED")
  createdAt                 DateTime @default(now())

  @@index([round])
  @@map("federated_rounds")
}

model TenantPrivacyBudget {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  epsilonBudgetMax    Float     @default(10.0) // Límite máximo de épsilon (presupuesto de privacidad)
  epsilonSpent        Float     @default(0.0)  // Épsilon acumulado gastado
  delta               Float     @default(0.00001) // Delta (1e-5)
  roundsParticipated  Int       @default(0)
  lastContributionAt  DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
  @@map("tenant_privacy_budgets")
}

model MorlPolicyRun {
  id                    String                @id @default(cuid())
  tenantId              String?
  tenant                Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title                 String
  budgetLimit           Float                 // Presupuesto tope ($)
  targetDepartment      String                @default("ALL")
  sampleSize            Int                   @default(0)
  hyperparametersJson   String                @db.Text // alpha, gamma, epsilon, episodes
  paretoFrontierJson    String                @db.Text // Puntos no dominados serializados
  selectedPointIndex    Int                   @default(0)
  frontierPoints        ParetoFrontierPoint[]
  createdAt             DateTime              @default(now())

  @@index([tenantId])
  @@map("morl_policy_runs")
}

model ParetoFrontierPoint {
  id                    String        @id @default(cuid())
  policyRunId           String
  policyRun             MorlPolicyRun @relation(fields: [policyRunId], references: [id], onDelete: Cascade)
  weightRetention       Float         // Peso de preferencia w1 (Retención)
  weightCost            Float         // Peso de preferencia w2 (Costo)
  totalCostEstimate     Float         // Presupuesto consumido ($)
  expectedRetentionRate Float         // Tasa de retención esperada (%)
  retainedEmployeeCount Int           // Empleados retenidos
  policyActionsJson     String        @db.Text // Acciones recomendadas por categoría de riesgo
  createdAt             DateTime      @default(now())

  @@index([policyRunId])
  @@map("pareto_frontier_points")
}





