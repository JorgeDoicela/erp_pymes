# ==============================================================================
# EMPLIFI ERP - CONFIGURACIÓN DE ENTORNO (PRODUCCIÓN & DOCKER COMPOSE)
# Ubicación en VPS: /var/www/recursos_humanos/.env
# ==============================================================================

NODE_ENV=production

# --- BASE DE DATOS POSTGRESQL ---
POSTGRES_USER=admin_rh
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=db_recursos_humanos
DATABASE_URL=postgresql://admin_rh:generate_a_secure_postgres_password_here@db:5432/db_recursos_humanos?schema=public

# --- REDIS (SESIONES Y WEBSOCKETS) ---
REDIS_URL=redis://redis:6379

# --- SEGURIDAD Y CRIPTOGRAFÍA ---
# Generar claves ejecutando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_secure_jwt_secret_at_least_64_characters_here
ENCRYPTION_KEY=generate_a_32_byte_hex_encryption_key_here
SEED_SECRET=generate_a_secure_seed_secret_here

# Inicialización de base de datos en primer arranque (crea superadmin y catálogos)
RUN_SEED=true

# --- DOMINIO Y AUTENTICACIÓN WEBAUTHN ---
CLIENT_URL=https://norma.doicela.dev
FRONTEND_URL=https://norma.doicela.dev
ORIGIN=https://norma.doicela.dev
RP_ID=doicela.dev
ALLOWED_ORIGINS=https://norma.doicela.dev
BIOMETRIC_MAX_AGE_DAYS=90

# --- SERVIDOR DE CORREO SMTP (NOTIFICACIONES) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-smtp-app-password
