# ==============================================================================
# NORMA ERP - FUENTE ÚNICA DE VERDAD (.env.example)
# Arquitectura 100% Dockerizada (Desarrollo y Producción)
# Ubicación: Raíz del proyecto (leído automáticamente por docker compose)
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. REGISTRO DE IMÁGENES DOCKER (GHCR)
# ------------------------------------------------------------------------------
BACKEND_IMAGE="ghcr.io/jorgedoicela/rh-backend:latest"
FRONTEND_IMAGE="ghcr.io/jorgedoicela/rh-frontend:latest"
GATEWAY_IMAGE="ghcr.io/jorgedoicela/rh-gateway:latest"

# ------------------------------------------------------------------------------
# 1. ENTORNO DE EJECUCIÓN
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL (Contenedor 'db' en red interna Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=admin_rh
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=db_recursos_humanos
POSTGRES_PORT=5432
DATABASE_URL="postgresql://usuario:password@db:5432/db_recursos_humanos?schema=public"

# ------------------------------------------------------------------------------
# 3. CACHÉ Y TIEMPO REAL REDIS (Contenedor 'redis' en red interna Docker)
# ------------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. PUERTOS Y VOLÚMENES DEL GATEWAY NGINX (Reverse Proxy Perimetral)
# ------------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
# CERTS_PATH=/var/www/recursos_humanos/certs

# ------------------------------------------------------------------------------
# 5. SEGURIDAD, TOKENS Y CRIPTOGRAFÍA
# ------------------------------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-jwt-secret-at-least-64-characters-long"
ENCRYPTION_KEY="your-32-byte-hex-key-here"
SEED_SECRET="your-seed-secret-here"
RUN_SEED=true
SUPERADMIN_PHONE="0999999999"

# ------------------------------------------------------------------------------
# 6. DOMINIOS, CORS Y AUTENTICACIÓN WEBAUTHN (BIOMETRÍA)
# ------------------------------------------------------------------------------
CLIENT_URL="https://norma.doicela.dev"
FRONTEND_URL="https://norma.doicela.dev"
ORIGIN="https://norma.doicela.dev"
APP_URL="https://norma.doicela.dev"
RP_ID="doicela.dev"
ALLOWED_ORIGINS="https://norma.doicela.dev"
BIOMETRIC_MAX_AGE_DAYS=90

# ------------------------------------------------------------------------------
# 7. SERVIDOR DE CORREO SMTP TRANSACCIONAL (NOTIFICACIONES Y SEGURIDAD)
# ------------------------------------------------------------------------------
# OPCIÓN A: Si usas Gmail (pega tu correo y contraseña de aplicación de 16 caracteres aquí):
EMAIL_USER="tu-correo@gmail.com"
EMAIL_PASS="tu_contraseña_de_aplicacion_aqui"
EMAIL_FROM="Norma ERP <tu-correo@gmail.com>"

# OPCIÓN B: Si usas Servidor SMTP dedicado / Corporativo (descomenta y completa):
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="apikey"
# SMTP_PASS="SG.your_api_key_here"
# SMTP_POOL="true"
# SMTP_MAX_CONNECTIONS=5
# EMAIL_FROM="Norma ERP <notificaciones@normaerp.com>"
# EMAIL_REPLY_TO="soporte@normaerp.com"

# Nota: Si no defines ninguna variable, el sistema opera en modo simulación (logs limpios en consola).

# ------------------------------------------------------------------------------
# 8. MOTOR DE INTELIGENCIA ARTIFICIAL (DEEPSEEK / GEMINI / MULTI-PROVEEDOR)
# ------------------------------------------------------------------------------
# Proveedores soportados: deepseek | gemini | openai | anthropic | groq | local_ollama | local_openai
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY="sk-tu_api_key_de_deepseek_aqui"
GEMINI_API_KEY="tu_api_key_de_google_gemini_aqui"
AI_MODEL="deepseek-chat"
AI_LLM_TIMEOUT_MS=25000

# Si usas tu propio modelo entrenado con Fine-Tuning en local (Ollama GGUF o vLLM / LM Studio):
# AI_PROVIDER="local_ollama"
# AI_LLM_URL="http://127.0.0.1:11434"
# AI_LLM_MODEL="ecuador-erp-ai"
# AI_EMBEDDING_MODEL="nomic-embed-text"

# Repositorios de Modelos Entrenados en Hugging Face Hub (Cuenta: doiceladev):
HF_TOKEN="hf_tu_token_de_huggingface_aqui"
HUGGINGFACE_HUB_TOKEN="hf_tu_token_de_huggingface_aqui"
HF_NAMESPACE="doiceladev"
HF_LORA_REPO_ID="doiceladev/norma-erp-ecuador-qwen2.5-7b-lora"
HF_RETRIEVER_REPO_ID="doiceladev/norma-erp-ecuador-retriever-e5"
HF_EVALUATOR_REPO_ID="doiceladev/norma-erp-ecuador-evaluator-reranker"

# ------------------------------------------------------------------------------
# 9. INTEGRACIÓN META WHATSAPP CLOUD API (ASISTENTE CORPORATIVO ERP)
# ------------------------------------------------------------------------------
# ID del número telefónico en el panel de Meta for Developers (WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID="tu_phone_number_id_aqui"

# Token de acceso de Meta (System User Token permanente con permiso whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN="tu_whatsapp_access_token_aqui"

# Token de verificación secreto que introduces en el panel de Webhooks de Meta
WHATSAPP_VERIFY_TOKEN="norma_erp_whatsapp_webhook_verify_secret_2026"

# App Secret de tu aplicación Meta para validación de firma criptográfica x-hub-signature-256
WHATSAPP_APP_SECRET=""

# Proveedor de IA para WhatsApp: deepseek | gemini (por defecto toma AI_PROVIDER)
WHATSAPP_AI_PROVIDER="deepseek"

# Colaborador demo opcional sembrado en Empresa Demo Ecuador S.A. para pruebas de WhatsApp + OTP 2FA
# DEMO_EMPLOYEE_PHONE="0999999999"
# DEMO_EMPLOYEE_EMAIL="usuario+demo@gmail.com"
# DEMO_EMPLOYEE_IDENTITY="1750000001"
