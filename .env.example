# ==============================================================================
# EMPLIFI ERP - FUENTE ÚNICA DE VERDAD (.env.example)
# Arquitectura 100% Dockerizada (Desarrollo y Producción)
# Ubicación: Raíz del proyecto (leído automáticamente por docker compose)
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. REGISTRO DE IMÁGENES DOCKER (GHCR)
# ------------------------------------------------------------------------------
BACKEND_IMAGE="ghcr.io/jorgedoicela/rh-backend:latest"
FRONTEND_IMAGE="ghcr.io/jorgedoicela/rh-frontend:latest"
GATEWAY_IMAGE="ghcr.io/jorgedoicela/rh-gateway:latest"

# ------------------------------------------------------------------------------
# 1. ENTORNO DE EJECUCIÓN
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL (Contenedor 'db' en red docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=admin_rh
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=db_recursos_humanos
DATABASE_URL="postgresql://usuario:password@db:5432/db_recursos_humanos?schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS (Contenedor 'redis' en red docker)
# ------------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# 4. SEGURIDAD, TOKENS Y CRIPTOGRAFÍA
# ------------------------------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-jwt-secret-at-least-64-characters-long"
ENCRYPTION_KEY="your-32-byte-hex-key-here"
SEED_SECRET="your-seed-secret-here"
RUN_SEED=true

# ------------------------------------------------------------------------------
# 5. DOMINIOS, CORS Y AUTENTICACIÓN WEBAUTHN (BIOMETRÍA)
# ------------------------------------------------------------------------------
CLIENT_URL="https://norma.doicela.dev"
FRONTEND_URL="https://norma.doicela.dev"
ORIGIN="https://norma.doicela.dev"
APP_URL="https://norma.doicela.dev"
RP_ID="doicela.dev"
ALLOWED_ORIGINS="https://norma.doicela.dev"
BIOMETRIC_MAX_AGE_DAYS=90

# ------------------------------------------------------------------------------
# 6. SERVIDOR DE CORREO SMTP (NOTIFICACIONES)
# ------------------------------------------------------------------------------
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-smtp-app-password"
